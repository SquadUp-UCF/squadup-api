# MongoDB connection string (e.g. mongodb://localhost:27017/squadup)
MONGO_URI=MONGO_URI

# Secret used to sign JWT access tokens
JWT_SECRET=JWT_SECRET

# JWT lifetime (e.g. 1d, 12h, 3600s)
JWT_EXPIRES_IN=7d

# HTTP port the API listens on
PORT=5000

# Resend API key used to email verification codes (https://resend.com)
RESEND_API_KEY=RESEND_API_KEY

# Optional: sender for verification emails. Defaults to Resend's sandbox
# address, which only delivers to the Resend account owner's own inbox —
# set a verified domain sender for real use.
RESEND_FROM="Squad Up <noreply@yourdomain.com>"

# Optional: absolute URL to the Squad-Up emblem shown in the verification
# email header. Defaults to the production logo. Point it at your own asset
# to rebrand the email without a code change.
EMAIL_LOGO_URL=https://squad-up-ucf.net/logo.png

# Optional: base URL of the web app, used to build the password-reset link
# (`<FRONTEND_URL>/reset-password?token=…`). Defaults to production — point it
# at your local front end (e.g. http://localhost:5173) when testing the flow,
# or the emailed link will send you to the live site.
FRONTEND_URL=https://squad-up-ucf.net

# Optional: the Have I Been Pwned breach check on registration is enabled by
# default. Set to `false` to disable it (e.g. offline development).
# PWNED_PASSWORD_CHECK=false

# Optional: set when the API runs behind a reverse proxy (e.g. nginx) so the
# real client IP from X-Forwarded-For is used for rate limiting. Value is the
# number of trusted proxy hops (usually 1). Leave unset for local/direct runs.
# TRUST_PROXY=1
